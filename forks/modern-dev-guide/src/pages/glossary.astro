---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';

const terms = (await getCollection('glossary')).sort((a, b) => a.data.term.localeCompare(b.data.term));
---

<Base title="Glossary · Working With LLMs" description="Definitions for the guide's recurring terms.">
  <header class="site-header">
    <a class="brand" href="/">Working With LLMs</a>
    <button type="button" class="theme-toggle" data-theme-toggle>Toggle theme</button>
  </header>

  <main id="main" class="home-main">
    <section class="hero">
      <h1>Glossary</h1>
      <p>
        The guide's recurring terms, defined in one or two sentences. This page is also where every in-text term
        link goes if JavaScript or popovers are unavailable.
      </p>
    </section>

    <dl class="glossary-list">
      {
        terms.map((entry) => (
          <div class="glossary-item" id={entry.id}>
            <dt class="glossary-term">{entry.data.term}</dt>
            <dd class="glossary-def">{entry.data.definition}</dd>
          </div>
        ))
      }
    </dl>
  </main>
</Base>
